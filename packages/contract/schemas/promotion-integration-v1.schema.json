{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promotion-integration-v1.schema.json",
  "title": "Promotion Integration Manifest v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "oneOf": [
        { "const": 1 },
        { "const": "1" }
      ]
    },
    "type": { "enum": ["script", "iframe"] },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,39})$"
    },
    "integrationKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "entry": { "$ref": "#/$defs/path" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/path" },
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "scriptType": { "enum": ["classic", "module"] }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "feedback": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "events": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
    }
  },
  "additionalProperties": true
}
