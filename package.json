{
  "name": "@parloq-flow/promotion-kit",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:components": "node scripts/sync-template-components.mjs",
    "check:components": "node scripts/sync-template-components.mjs --check",
    "preview": "npm run check:components && node scripts/preview.mjs",
    "validate": "npm run validate:template",
    "validate:template": "node packages/cli/src/index.mjs template validate themes/white-label-account-link",
    "check:scripts": "node --check scripts/template-catalog.mjs && node --check scripts/preview.mjs && node --check scripts/sync-template-components.mjs && node --check packages/cli/src/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test packages/cli/test/*.test.mjs",
    "ci": "npm run check:scripts && npm run check:components && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.9",
    "libphonenumber-js": "1.13.11",
    "typescript": "~5.7.2"
  }
}
